    {
      "parameters": {
        "jsCode": "const items = $input.first().json.data.map(i => ({\n  ...i.output,\n  title: i.title,\n  link: i.link,\n  source: i.source,\n  isoDate: i.isoDate,\n  contentSnippet: i.contentSnippet\n}));\n\nitems.sort((a, b) => b.score - a.score);\n\nconst picked = [];\nconst usedSources = new Set();\n\nfor (const item of items) {\n  if (picked.length >= 3) break;\n  if (!usedSources.has(item.source)) {\n    picked.push(item);\n    usedSources.add(item.source);\n  }\n}\n\nfor (const item of items) {\n  if (picked.length >= 3) break;\n  if (!picked.includes(item)) picked.push(item);\n}\n\nreturn picked.map(i => ({ json: i }));"
      },
      "id": "ebace6d1-a110-42fd-a115-6069e605407c",
      "name": "Pick Top 3",
      "type": "n8n-nodes-base.code",
