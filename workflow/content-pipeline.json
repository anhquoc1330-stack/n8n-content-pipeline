      "parameters": {
        "jsCode": "const llmItems = $input.all();\nconst originalItems = $('Filter - Tin trong 7 ngay').all();\n\nreturn llmItems.map((item, i) => ({\n  json: {\n    ...originalItems[i].json,\n    output: item.json.output\n  }\n}));"
