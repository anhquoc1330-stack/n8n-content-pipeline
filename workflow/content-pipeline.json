    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst html = item.data || '';\n\nconst match = html.match(/<meta[^>]+property=[\"']og:image[\"'][^>]+content=[\"']([^\"']+)[\"']/i)\n  || html.match(/<meta[^>]+content=[\"']([^\"']+)[\"'][^>]+property=[\"']og:image[\"']/i);\n\nconst imageUrl = match ? match[1] : null;\n\nreturn [{\n  json: {\n    text: item.text,\n    title: item.title,\n    link: item.link,\n    source: item.source,\n    isoDate: item.isoDate,\n    contentType: item.contentType,\n    imageUrl\n  }\n}];"
      },
      "id": "aa2b6881-eee3-4bb3-aa06-dec0a670835a",
      "name": "Tach anh og:image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2340,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst postsHtml = items.map((item, idx) => `\n  <div style=\"margin-bottom:30px; padding:15px; border:1px solid #ddd; border-radius:8px;\">\n    <h3>Bai ${idx + 1}: ${item.title}</h3>\n    ${item.imageUrl ? `<img src=\"${item.imageUrl}\" style=\"max-width:100%; border-radius:6px;\" />` : '<p><em>(Khong tim duoc anh, tu tim them nhe)</em></p>'}\n    <p style=\"white-space:pre-wrap;\">${item.text}</p>\n    <p><a href=\"${item.link}\">Nguon: ${item.source}</a></p>\n  </div>\n`).join('');\n\nconst html = `\n  <h2>3 bai AI da viet san hom nay - Tap Hoa AI</h2>\n  <p>Ung bai nao thi copy noi dung + tai anh, dan thang len Facebook nhe.</p>\n  ${postsHtml}\n`;\n\nreturn [{ json: { emailHtml: html } }];"
      },
